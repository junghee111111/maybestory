; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="elinia"
config/name_localized={
"en_US": "",
"ja_JP": "",
"ko_KR": ""
}
config/version="1.11"
run/main_scene="res://ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://shader/icon.svg"

[autoload]

KeyboardManager="*uid://dyfhca5teb8b6"
MapLoader="*res://scripts/core/MapLoader.cs"
SaveManager="*res://scripts/core/SaveManager.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="elinia"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[file_customization]

folder_colors={
"res://map/": "red"
}

